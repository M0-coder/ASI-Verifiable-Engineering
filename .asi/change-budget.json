{
  "version": 2,
  "max_files": 80,
  "allowed_prefixes": [
    ".asi/",
    ".github/",
    "guardian/",
    "producer/",
    "skills/",
    "tools/"
  ],
  "allowed_root_files": [
    "AGENTS.md",
    "CHANGELOG.md",
    "README.md",
    "SECURITY.md",
    "VERSION",
    "mypy.ini",
    "requirements-ci.lock"
  ],
